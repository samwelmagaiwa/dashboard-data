COMPOSE_PROJECT_NAME=clinicaldashboard
IMAGE_TAG=latest

BACKEND_IMAGE=samwelmagaiwa/dashboard-backend
FRONTEND_IMAGE=samwelmagaiwa/dashboard-frontend

BACKEND_ENV_FILE=./env/backend.production.env
BACKEND_STORAGE_PATH=./dashboard-backend/storage

FRONTEND_PORT=8081
FRONTEND_SERVER_NAME=clinicaldashboard.mloganzila.or.tz
BACKEND_UPSTREAM=http://dashboard_backend:80
VITE_API_BASE_URL=/api/v1

# Set to true only when you intentionally want the web container to run migrations.
RUN_MIGRATIONS=false
